{
  "env": {
    "DO_NOT_TRACK": "1",
    "GRAFT_TRAIL_AUTOPUSH": "0"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/global-sync.cjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/context-guard.cjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/context-guard.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
